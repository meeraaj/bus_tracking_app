{
  "rules": {
    ".read": false,
    ".write": false,

    "drivers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "routes": {
      "$routeId": {
        ".read": "auth != null",
        ".write": false,

        "live_location": {
          ".write": "auth != null && root.child('drivers').child(auth.uid).child('active').val() === true && root.child('drivers').child(auth.uid).child('assignedRoute').val() === $routeId",
          ".validate": "newData.hasChildren(['latitude', 'longitude', 'bearing', 'speedKmh', 'timestamp', 'status'])",

          "latitude": {
            ".validate": "newData.isNumber() && newData.val() >= 12.5 && newData.val() <= 13.5"
          },
          "longitude": {
            ".validate": "newData.isNumber() && newData.val() >= 79.5 && newData.val() <= 80.5"
          },
          "bearing": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 360"
          },
          "speedKmh": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 120"
          },
          "timestamp": {
            ".validate": "newData.isNumber() && newData.val() <= (now + 5000) && newData.val() >= (now - 60000)"
          },
          "status": {
            ".validate": "newData.isString() && (newData.val() === 'ACTIVE' || newData.val() === 'OFFLINE')"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
